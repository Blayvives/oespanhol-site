# Exemplo de variáveis de ambiente — copie para .env (fora da webroot) ou app_private/config.local.php
APP_ENV=production
APP_URL=https://oespanhol.com.br
APP_TIMEZONE=America/Sao_Paulo

# Banco MySQL 11.4 na KingHost
DB_HOST=mysql.oespanhol.com.br
DB_HOST_FALLBACK=mysql50-farm1.kinghost.net
DB_PORT=3306
DB_NAME=oespanhol
DB_USER=oespanhol
DB_PASS=TROQUE_POR_SENHA_FORTE_DA_KINGHOST
DB_CHARSET=utf8mb4

# Segurança de Sessão e Backoffice (RBAC)
SESSION_NAME=oespanhol_staff_sid
SESSION_IDLE_TIMEOUT=1800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
CSRF_SECRET=GERE_64_CHARS_ALEATORIOS_COM_OPENSSL_RAND_HEX_32

# Gateway de Pagamento / Webhook
PAYMENT_PROVIDER=asaas
PAYMENT_API_KEY=TROQUE_PELA_CHAVE_DO_GATEWAY
PAYMENT_WEBHOOK_SECRET=TROQUE_PELO_SEGREDO_HMAC_DO_WEBHOOK
